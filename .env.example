# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed to GitHub.
# For GitHub Pages deployment, add these as Repository Secrets
# in: GitHub repo → Settings → Secrets and variables → Actions → New repository secret

VITE_FORM_EMAIL=your-email@example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.
